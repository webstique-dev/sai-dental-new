# Copy this file to .env on your server or set these environment variables in Render Dashboard.

# MongoDB Connection URI (Local or MongoDB Atlas Cluster)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sai_dental_clinic?retryWrites=true&w=majority

# Server Port (Render provides PORT automatically)
PORT=5000
NODE_ENV=production

# JWT Authentication Secrets
JWT_SECRET=your_long_secure_random_jwt_secret_key_here
JWT_EXPIRES_IN=8h

# CORS Allowed Client Origin (Set to your deployed Vercel frontend URL e.g. https://sai-dental.vercel.app or comma-separated list)
CLIENT_ORIGIN=https://your-app.vercel.app,http://localhost:5173
